# Copy this file to .env and fill in your values

DATABASE_URL="file:./prisma/fintrack.db"

# Generate a strong random secret (e.g. openssl rand -hex 32)
JWT_SECRET="your-secret-key-here"

# Login credentials for the app
APP_USERNAME="your_username"
APP_PASSWORD="your_password"

# For local development: allow frontend dev server
CORS_ORIGIN="http://localhost:5173"

PORT=3001

# Telegram bot (optional — bot won't start if token is missing)
# Get token from @BotFather, chat_id from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
